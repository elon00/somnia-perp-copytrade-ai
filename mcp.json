{
  "mcpServers": {
    "somnia-perp-copytrade-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "Somnia Network",
        "PROJECT_TICKER": "SOMCOPY"
      },
      "tools": [
        {
          "name": "verify_somcopy_invariants",
          "description": "Verifies deterministic invariants for Somnia Perp Copytrade AI on Somnia Network."
        },
        {
          "name": "execute_somcopy_action",
          "description": "Executes authenticated DeFi state transition."
        }
      ]
    }
  }
}